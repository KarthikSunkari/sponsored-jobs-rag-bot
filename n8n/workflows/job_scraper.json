                            }
                        ]
                    }
                },
                "bodyParametersJson": "={{ JSON.stringify({\n  company_id: $json[0].id,\n  title: $node[\"Normalize Jobs\"].json.title,\n  description: $node[\"Normalize Jobs\"].json.description,\n  location: $node[\"Normalize Jobs\"].json.location,\n  job_url: $node[\"Normalize Jobs\"].json.job_url,\n  url_hash: $node[\"Normalize Jobs\"].json.url_hash,\n  source: $node[\"Normalize Jobs\"].json.source,\n  posted_date: $node[\"Normalize Jobs\"].json.posted_date\n}) }}"
            },
