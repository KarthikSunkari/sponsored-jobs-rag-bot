            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                450,
                200
            ]
        },
        {
            "parameters": {
                "url": "https://jobs.github.com/positions.json",
                "options": {}
            },
            "id": "github-jobs",
            "name": "GitHub Jobs",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                450,
                400
            ]
        },
        {
            "parameters": {
                "functionCode": "// Process and normalize job data from different sources\nconst items = [];\n\nfor (const item of $input.all()) {\n  const source = item.json.source || 'unknown';\n  let normalized = {};\n  \n  if (source === 'remoteok') {\n    normalized = {\n      title: item.json.position,\n      company: item.json.company,\n      description: item.json.description,\n      location: item.json.location || 'Remote',\n      job_url: item.json.url,\n      source: 'remoteok',\n      posted_date: item.json.date\n    };\n  } else if (source === 'github') {\n    normalized = {\n      title: item.json.title,\n      company: item.json.company,\n      description: item.json.description,\n      location: item.json.location,\n      job_url: item.json.url,\n      source: 'github',\n      posted_date: item.json.created_at\n    };\n  }\n  \n  // Generate URL hash for deduplication\n  const crypto = require('crypto');\n  normalized.url_hash = crypto.createHash('md5').update(normalized.job_url).digest('hex');\n  \n  items.push({ json: normalized });\n}\n\nreturn items;"
            },
            "id": "normalize-jobs",
            "name": "Normalize Jobs",
            "type": "n8n-nodes-base.function",
            "typeVersion": 1,
            "position": [
                650,
                300
            ]
        },
        {
            "parameters": {
                "authentication": "headerAuth",
                "url": "={{ $env.SUPABASE_URL }}/rest/v1/companies",
                "options": {
                    "headers": {
                        "headerParameters": [
                            {
                                "name": "apikey",
                                "value": "={{ $env.SUPABASE_KEY }}"
                            },
                            {
                                "name": "Authorization",
                                "value": "Bearer {{ $env.SUPABASE_KEY }}"
                            }
                        ]
                    },
                    "queryParameters": {
                        "parameters": [
                            {
                                "name": "employer_name",
                                "value": "eq.{{ $json.company }}"
                            },
                            {
                                "name": "select",
                                "value": "id,employer_name,approval_rate"
                            }
                        ]
                    }
                }
            },
            "id": "check-sponsorship",
            "name": "Check Sponsorship",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 3,
            "position": [
                850,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
